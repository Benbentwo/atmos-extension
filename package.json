{
  "name": "cloudposse-atmos",
  "displayName": "Atmos",
  "description": "IntelliSense, navigation, and validation for Cloud Posse Atmos stacks and components",
  "version": "0.1.0",
  "publisher": "cloudposse",
  "icon": "appicon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benbentwo/atmos-extension"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "atmos",
    "terraform",
    "cloudposse",
    "infrastructure",
    "devops",
    "yaml"
  ],
  "activationEvents": [
    "workspaceContains:**/atmos.yaml",
    "workspaceContains:**/atmos.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "atmos.renderStack",
        "title": "Atmos: Render Stack Configuration"
      },
      {
        "command": "atmos.validateStack",
        "title": "Atmos: Validate Stack"
      },
      {
        "command": "atmos.openAtmosConfig",
        "title": "Atmos: Open Configuration"
      },
      {
        "command": "atmos.showStackContext",
        "title": "Atmos: Show Stack Context",
        "icon": "$(layers)"
      },
      {
        "command": "atmos.previewComponent",
        "title": "Atmos: Preview Component",
        "icon": "$(eye)"
      },
      {
        "command": "atmos.switchWorkspace",
        "title": "Atmos: Switch Workspace",
        "icon": "$(folder)"
      },
      {
        "command": "atmos.showWorkspaceInfo",
        "title": "Atmos: Show Workspace Info",
        "icon": "$(info)"
      },
      {
        "command": "atmos.stackViewer.refresh",
        "title": "Refresh Stack Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "atmos.stackViewer.openComponent",
        "title": "Open Component"
      },
      {
        "command": "atmos.stackViewer.openFile",
        "title": "Open File"
      },
      {
        "command": "atmos.explorer.openComponent",
        "title": "Open Component"
      },
      {
        "command": "atmos.componentsView.openComponent",
        "title": "Open Component"
      },
      {
        "command": "atmos.componentsView.refresh",
        "title": "Refresh Components View",
        "icon": "$(refresh)"
      },
      {
        "command": "atmos.componentsView.search",
        "title": "Search Components",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atmos-explorer",
          "title": "Atmos",
          "icon": "resources/activitybar.png"
        }
      ]
    },
    "views": {
      "atmos-explorer": [
        {
          "id": "atmosStackViewer",
          "name": "Stack Viewer",
          "contextualTitle": "Atmos Stack Viewer"
        },
        {
          "id": "atmosComponents",
          "name": "Components",
          "contextualTitle": "Atmos Components",
          "when": "resourceLangId == yaml"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "atmos.stackViewer.refresh",
          "when": "view == atmosStackViewer",
          "group": "navigation"
        },
        {
          "command": "atmos.componentsView.refresh",
          "when": "view == atmosComponents",
          "group": "navigation@1"
        },
        {
          "command": "atmos.componentsView.search",
          "when": "view == atmosComponents",
          "group": "navigation@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "atmos.stackEditor",
        "displayName": "Atmos Stack Editor",
        "selector": [
          {
            "filenamePattern": "**/stacks/**/*.{yaml,yml}"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "Atmos",
      "properties": {
        "atmos.cliPath": {
          "type": "string",
          "default": "atmos",
          "description": "Path to the Atmos CLI executable"
        },
        "atmos.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time validation of stack files"
        },
        "atmos.validation.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate stack files on save"
        },
        "atmos.explorer.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show stack names in Explorer file decorations"
        },
        "atmos.explorer.showComponents": {
          "type": "boolean",
          "default": true,
          "description": "Show component tree in Explorer for stack files"
        },
        "atmos.editor.useCustomEditor": {
          "type": "boolean",
          "default": false,
          "description": "Use custom editor for stack files (set to 'option' priority)"
        },
        "atmos.editor.showPreview": {
          "type": "boolean",
          "default": true,
          "description": "Show preview pane in custom editor"
        },
        "atmos.language.evaluateTemplates": {
          "type": "boolean",
          "default": true,
          "description": "Evaluate and show template values"
        },
        "atmos.language.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline hints for resolved values"
        },
        "atmos.components.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh components view when files change"
        }
      }
    },
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "aliases": [
          "YAML",
          "yaml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1"
  }
}
